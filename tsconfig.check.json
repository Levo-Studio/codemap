{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "scripts/**/*.mjs",
    "packages/*/src/**/*.test.ts",
    "packages/web/e2e/**/*.ts"
  ]
}
