{
  "name": "codemap-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
